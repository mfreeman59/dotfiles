#!/usr/bin/env bash
# テスト用の偽 claude（plugin サブコマンドの一部だけ）。
# 状態は $FAKE_DIR/claude.json、呼び出しは $FAKE_DIR/calls.log に記録する。
set -uo pipefail
state="${FAKE_DIR}/claude.json"
echo "claude $*" >>"${FAKE_DIR}/calls.log"
# sleep の入出力を閉じておく（時間切れで親が止められても、コマンド置換が sleep の終わりを待たないように）
[ -n "${FAKE_SLOW:-}" ] && sleep "$FAKE_SLOW" </dev/null >/dev/null 2>&1
[ "${FAKE_BROKEN:-}" = 1 ] && { echo "fake failure" >&2; exit 1; }
upd() { local tmp; tmp="$(mktemp)"; jq "$@" "$state" >"$tmp" && mv "$tmp" "$state"; }
in_list() { jq -e --arg x "$2" --arg l "$1" '.[$l] | index($x) != null' "$state" >/dev/null; }

# 偽の claude -p: --json-schema の required[0]（needs か recommendations）を名前にして応答を選ぶ。
# $FAKE_DIR/p-<名前>.json があれば構造化出力として返し、なければ is_error を返す。p-<名前>.fail があれば終了コード 1。
# 受け取ったプロンプトを p-<名前>.prompt に、作業ディレクトリと KIT_NESTED を p-<名前>.env に記録する
if [ "${1:-}" = -p ]; then
  schema="" prev=""
  for a in "$@"; do
    [ "$prev" = --json-schema ] && schema="$a"
    prev="$a"
  done
  kind="$(jq -r '.required[0]' <<<"$schema")"
  cat >"${FAKE_DIR}/p-${kind}.prompt"
  printf 'cwd=%s nested=%s\n' "$PWD" "${KIT_NESTED:-}" >"${FAKE_DIR}/p-${kind}.env"
  [ -f "${FAKE_DIR}/p-${kind}.fail" ] && exit 1
  if [ -f "${FAKE_DIR}/p-${kind}.json" ]; then
    jq -c '{type: "result", subtype: "success", is_error: false, structured_output: .}' "${FAKE_DIR}/p-${kind}.json"
  else
    echo '{"type":"result","subtype":"error_max_budget_usd","is_error":true}'
  fi
  exit 0
fi

[ "${1:-}" = plugin ] || exit 2
shift
case "${1:-} ${2:-}" in
  "list --available")
    if [ -f "${FAKE_DIR}/available.json" ]; then cat "${FAKE_DIR}/available.json"; else echo '{"installed":[],"available":[]}'; fi ;;
  "list --json")
    # 本物の CLI と同じく、作業ディレクトリのプロジェクト設定（enabledPlugins）が enabled を上書きする
    proj='{}'
    [ -f "${PWD}/.claude/settings.json" ] && proj="$(jq -c '.enabledPlugins // {}' "${PWD}/.claude/settings.json")"
    jq -c --argjson proj "$proj" '[.plugins[] | .id as $id | {id, scope: (.scope // "user"), enabled: (if ($proj | has($id)) then $proj[$id] else .enabled end), version: "1.0.0"}]' "$state" ;;
  "marketplace list")
    jq -c '[.marketplaces[] | . + {installLocation: "/tmp/fake"}]' "$state" ;;
  "marketplace add")
    src="$3"
    in_list fail "$src" && { echo "fake: add failed" >&2; exit 1; }
    name="${FAKE_MKT_NAME:-${src##*/}}"
    upd --arg n "$name" --arg r "$src" '.marketplaces |= (map(select(.name != $n)) + [{name: $n, source: "github", repo: $r}])' ;;
  "marketplace remove")
    # 本物の CLI と同じく、そのマーケットプレイスのプラグインも（スコープを問わず）消える
    upd --arg n "$3" '.marketplaces |= map(select(.name != $n)) | .plugins |= map(select(.id | endswith("@" + $n) | not))' ;;
  install*)
    id="$2" mkt="" accept=""
    shift 2
    while [ $# -gt 0 ]; do
      case "$1" in
        --marketplace) mkt="$2"; shift ;;
        --accept-command) accept="$2"; shift ;;
      esac
      shift
    done
    if [ -n "$mkt" ]; then
      # 本物の CLI と同じく、--marketplace のマーケットプレイスをユーザー設定に登録してから入れる
      name="${FAKE_MKT_NAME:-${mkt##*/}}"
      upd --arg n "$name" --arg r "$mkt" '.marketplaces |= (map(select(.name != $n)) + [{name: $n, source: "github", repo: $r}])'
      id="${id}@${name}"
    fi
    if in_list command_source "$id" && [ "$accept" != abc ]; then
      printf '{"command":"install","outcome":"failed","plugin":"%s","shownCommand":{"command":"make","sha256":"abc"}}\n' "$id"
      exit 1
    fi
    if in_list fail "$id"; then
      printf '{"command":"install","outcome":"failed","plugin":"%s","message":"boom"}\n' "$id"
      exit 1
    fi
    upd --arg id "$id" '.plugins |= (map(select(.id != $id)) + [{id: $id, enabled: true}])'
    printf '{"command":"install","outcome":"installed","plugin":"%s"}\n' "$id" ;;
  uninstall*)
    # 本物の CLI と同じく、入っていないプラグインの uninstall は失敗する
    jq -e --arg id "$2" 'any(.plugins[]; .id == $id)' "$state" >/dev/null || { echo "not installed" >&2; exit 1; }
    upd --arg id "$2" '.plugins |= map(select(.id != $id))' ;;
  enable*) upd --arg id "$2" '.plugins |= map(if .id == $id then .enabled = true else . end)' ;;
  disable*) upd --arg id "$2" '.plugins |= map(if .id == $id then .enabled = false else . end)' ;;
  *) echo "fake claude: 未対応: plugin $*" >&2; exit 2 ;;
esac
